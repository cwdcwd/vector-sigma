# balena/registrar/Dockerfile.caddy — the VS composition's TLS edge
# (fleet-ops-f57.13; rotation automated — see docs/tls-runbook.md).
#
# Caddy fronts the whole master-device composition: registrar (admin +
# API) and litellm (gateway + /ui + /a2a/*). The Caddyfile is baked (the
# balena supervisor cannot bind-mount — the litellm pattern); TLS is
# `tls internal` — Caddy's own local CA, self-provisioned and stored on
# the caddy-data volume. No certs-init dependency: Caddy needs nothing
# but the Caddyfile to start serving. deploy/ self-host builds the SAME
# image — one artifact, no twin drift.
#
# caddy:2-alpine is multi-arch (aarch64 included) — no build required, but
# an explicit FROM pin keeps the fleet's image lineage auditable.

FROM caddy:2-alpine

COPY Caddyfile /etc/caddy/Caddyfile

# Stock entrypoint/CMD (caddy:2-alpine's own ENTRYPOINT + this CMD) — no
# custom wait shim needed: `tls internal` has no external file dependency,
# so caddy can start immediately and self-provision its CA + leaf.
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
