#!/command/with-contenv sh
# shellcheck shell=sh
# vs-hub-router service (the VS hub-assigned dispatch spool, queue conventions).
# Always declared so s6 has a supervised slot; it RUNS only when
# the 04-vs-a2a-wiring hook has BOTH: derived a hub routing target from the
# bundle ($HERMES_HOME/a2a-guard/guard.json signed identity is on, and
# VS_HUB_TARGET_AGENT names the fleet's hub coordinator) and seeded the spool
# ($HERMES_HOME/vs-hub-queue). Without it the script exits 0 and ./finish
# returns 125 (permanent failure: s6 leaves the slot down), exactly like the
# stock dashboard service, so a composition without hub routing behaves
# exactly as before.
GD="${HERMES_HOME:-/opt/data}/a2a-guard"
VS_HUB_QUEUE_DIR="${VS_HUB_QUEUE_DIR:-${HERMES_HOME:-/opt/data}/vs-hub-queue}"
export VS_HUB_QUEUE_DIR
if [ ! -x /usr/local/bin/vs-hub-router ]; then
  echo "[vs-hub-router] idle: binary missing" >&2
  exit 0
fi
if [ -z "$VS_HUB_TARGET_AGENT" ]; then
  echo "[vs-hub-router] idle: hub_router_agent not in the bundle" >&2
  exit 0
fi
if [ ! -f "$GD/outbound-token" ] || [ ! -f "$GD/guard.json" ]; then
  echo "[vs-hub-router] idle: signed identity off (no outbound route)" >&2
  exit 0
fi
# Drop to the runtime user (the wiring hook seeds and chowns the spool to it).
[ "$(id -u)" = 0 ] || exec /opt/hermes/.venv/bin/python /usr/local/bin/vs-hub-router serve --queue-dir "$VS_HUB_QUEUE_DIR"
exec s6-setuidgid hermes /opt/hermes/.venv/bin/python /usr/local/bin/vs-hub-router serve --queue-dir "$VS_HUB_QUEUE_DIR"