# Vector Sigma registrar — example environment
# Copy to .env and adjust. Never commit real values.

# Postgres connection string (dedicated database, least-privilege role)
DATABASE_URL=postgres://registrar:registrar@localhost:5432/vector_sigma

# HTTP listen
PORT=3000
HOST=0.0.0.0

# Logging (pino level)
LOG_LEVEL=info

# Set true when behind a reverse proxy that sets X-Forwarded-For (rate
# limiting and audit source_ip depend on the real client IP)
TRUST_PROXY=false

# Per-IP auth rate limiting (bootstrap/status/admin console/owner API)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_FAILURES=5

# HMAC secret for admin-console session cookies — MUST be overridden in
# production (min 16 chars; generate e.g. with: openssl rand -base64 32)
SESSION_SECRET=change-me-generate-a-long-random-secret