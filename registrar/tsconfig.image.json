{
  // Image build only (registrar/Dockerfile). The shipped registrar is the
  // runtime service: the CI tooling that also lives in this workspace (the
  // OCI content gate, the credential scanner, the GHCR promoter) is compiled
  // and tested by `npm run build` / `npm test` but never shipped in the image.
  // registrar/test/image-build-config.test.ts pins this exclusion list.
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "drizzle",
    "src/credential-scan",
    "src/oci-gate",
    "src/registry"
  ]
}
