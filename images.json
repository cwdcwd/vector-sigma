{
  "$comment": "The one list of images vector-sigma builds. CI builds, scans, E2Es and promotes exactly these (scripts/image-catalog.mjs turns it into workflow matrices); balena releases and deploy/ consume the promoted GHCR digests. context is the docker build context relative to the repo root; dockerfile is relative to the repo root.",
  "registry": "ghcr.io/cwdcwd/vector-sigma",
  "platforms": [
    { "platform": "linux/amd64", "arch_tag": "amd64", "runner": "ubuntu-latest" },
    { "platform": "linux/arm64", "arch_tag": "arm64", "runner": "ubuntu-24.04-arm" }
  ],
  "components": {
    "registrar": { "dockerfile": "registrar/Dockerfile", "context": ".", "fleets": ["registrar"] },
    "registrant": { "dockerfile": "registrant/Dockerfile", "context": ".", "fleets": ["registrar", "devices"] },
    "hermes": { "dockerfile": "balena/registrar/Dockerfile.hermes", "context": ".", "fleets": ["registrar"] },
    "scotty": { "dockerfile": "balena/registrar/Dockerfile.scotty", "context": "balena/registrar", "fleets": ["registrar"] },
    "postgres": { "dockerfile": "balena/registrar/Dockerfile.postgres", "context": "balena/registrar", "fleets": ["registrar"] },
    "litellm": { "dockerfile": "balena/registrar/Dockerfile.litellm", "context": "balena/registrar", "fleets": ["registrar"] },
    "tailscale": { "dockerfile": "balena/registrar/Dockerfile.tailscale", "context": "balena/registrar", "fleets": ["registrar"] },
    "agent": { "dockerfile": "balena/devices/Dockerfile.agent-hermes", "context": ".", "fleets": ["devices"] },
    "tailscale-devices": { "dockerfile": "balena/devices/Dockerfile.tailscale", "context": "balena/devices", "fleets": ["devices"] }
  }
}
