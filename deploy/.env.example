# deploy/.env.example — copy to deploy/.env and fill in real values.
# Every value below is REQUIRED at `docker compose config` time
# (fail-closed ${VAR:?} interpolation in deploy/compose.yaml).

# Postgres (least-privilege: create a dedicated role + db for the registrar;
# do NOT reuse a superuser or an existing app's credentials).
POSTGRES_USER=vsigma
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vsigma

# Registrar admin-console session HMAC secret (>= 16 chars, random).
SESSION_SECRET=change-me-random-32-chars-minimum

# Loopback port for the published registrar endpoint (reverse-proxy in front
# for LAN/TLS exposure; see deploy/README.md).
REGISTRAR_PORT=3000

# Fastify log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# --- VS gateway (LiteLLM) — fleet-ops-f57.12 --------------------------------
# Master key for the gateway (virtual-key minting, Admin UI). Must start with
# "sk-" (LiteLLM requirement). Mint: openssl rand -base64 32 | sed 's/^/sk-/'
LITELLM_MASTER_KEY=sk-change-me-mint-random

# Password for the gateway's dedicated least-privilege postgres role. The
# litellm-init service provisions the role + `litellm` database on boot; the
# role owns ONLY that database. On every boot init re-asserts this value —
# rotating it here needs no manual psql step.
LITELLM_PG_PASSWORD=change-me-strong-password

# Ollama Cloud credential — the gateway's model upstream (OpenAI-compatible
# https://ollama.com/v1; override OLLAMA_CLOUD_API_BASE only if that moves).
OLLAMA_CLOUD_API_KEY=change-me-ollama-cloud-key

# Loopback port for the published gateway endpoint (reverse-proxy in front
# for LAN exposure; same posture as the registrar).
LITELLM_PORT=4000
# --- TLS edge (f57.13) ------------------------------------------------------
# The caddy edge serves https://TLS_HOSTNAME from the VS-own internal CA
# (generate with scripts/gen-vs-ca.sh — see docs/tls-runbook.md). Paste the
# single-line values from the script's b64-cert.env output.
TLS_HOSTNAME=vsigma.lan
TLS_CERT_B64=change-me-paste-from-vs-tls/b64-cert.env
TLS_KEY_B64=change-me-paste-from-vs-tls/b64-cert.env
