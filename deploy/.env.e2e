# deploy/.env.e2e — deterministic E2E values (compose-simulated device).
# Committed on purpose: these are SIMULATION credentials for a throwaway
# local compose project. Never put production secrets in this file.
#
# Used by: docker compose --env-file deploy/.env.e2e \
#            -f deploy/compose.yaml -f deploy/compose.e2e.yaml -p vector-sigma-e2e

# Same keys as deploy/.env.example (the base compose file is shared).
POSTGRES_USER=e2e
POSTGRES_PASSWORD=e2e-local-only
POSTGRES_DB=vsigma_e2e
SESSION_SECRET=e2e-session-secret-0123456789abcdef
REGISTRAR_PORT=3000
LOG_LEVEL=info

# The compose-simulated device.
E2E_DEVICE_UUID=11111111-2222-3333-4444-555555555555
E2E_DEVICE_KEY=bk_e2e-00000000-0000-0000-0000-000000000001
E2E_AGENT_NAME=sim-deploy-e2e

# Slot auto-rearm window (seconds) for the E2E: sized so the volume-wipe +
# device restart in e2e.sh ALWAYS lands INSIDE the window — AC3 requires the
# 425→Retry-After retry loop to fire, and fails loudly if it didn't. 180s
# absorbs slow runners (GitHub-hosted: cold compose up, image pulls) with
# the redelivery still observable inside the 10-minute CI job budget.
# Production default is 1 hour.
SEED_REARM_SECONDS=180