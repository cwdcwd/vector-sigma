# deploy/.env.e2e — deterministic E2E values (compose-simulated device).
# Committed on purpose: these are SIMULATION credentials for a throwaway
# local compose project. Never put production secrets in this file.
#
# Used by: docker compose --env-file deploy/.env.e2e \
#            -f deploy/compose.yaml -f deploy/compose.e2e.yaml -p vector-sigma-e2e

# Same keys as deploy/.env.example (the base compose file is shared).
POSTGRES_USER=e2e
POSTGRES_PASSWORD=e2e-local-only
POSTGRES_DB=vsigma_e2e
SESSION_SECRET=e2e-session-secret-0123456789abcdef
REGISTRAR_PORT=3000
LOG_LEVEL=info

# 77i: scotty basic_auth simulation value — the docs-canonical bcrypt
# hash of "hiccup" for user "owner" (caddy hash-password output for the
# docs example pair). SIMULATION ONLY, exactly like every other value in
# this file: the production hash is the owner-minted SCOTTY_BASIC_AUTH_
# HASH fleet variable, never committed. The Caddyfile consumes it via
# {$SCOTTY_BASIC_AUTH_HASH} substitution at adapt time.
# NOTE the $$ escapes: docker compose INTERPOLATES $-patterns in .env
# values ($$ de-escapes to a literal $). A raw bcrypt hash ($2a$14$...)
# would have its $-segments expanded as variables and arrive at caddy
# corrupted — CI run 1 of this lane failed exactly that way (authed 401).
# The balena side needs NO escape: the supervisor does no interpolation
# and dashboard-set fleet variables are literal bytes.
SCOTTY_BASIC_AUTH_HASH=$$2a$$14$$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG

# The compose-simulated device.
E2E_DEVICE_UUID=11111111-2222-3333-4444-555555555555
E2E_DEVICE_KEY=bk_e2e-00000000-0000-0000-0000-000000000001
E2E_AGENT_NAME=sim-deploy-e2e

# f57.11: grace-path device (PENDING row; the fix pass activates it) and
# the admin key e2e.sh uses to drive the real console flow. Simulation-only.
E2E_GRACE_UUID=11111111-2222-3333-4444-666666666666
E2E_GRACE_KEY=bk_e2e-00000000-0000-0000-0000-000000000002
E2E_ADMIN_KEY=ak_e2e-00000000-0000-0000-0000-000000000001

# f57.12: VS gateway (LiteLLM) simulation values — deterministic, never
# production secrets. OLLAMA_CLOUD_API_KEY is never exercised against the
# real upstream: the smoke asserts liveliness + the config-served model
# list only (no completion call, no upstream traffic).
LITELLM_MASTER_KEY=sk-e2e-litellm-master-0123456789abcdef
LITELLM_PG_PASSWORD=e2e-litellm-db-password
OLLAMA_CLOUD_API_KEY=e2e-simulation-ollama-key
LITELLM_PORT=4000

# f57.15: VS queue plane (dolt + scotty) simulation values — deterministic,
# never production secrets. The bd round-trip asserts against the compose
# dolt directly (init + create + list + close); no queue data leaves the
# throwaway CI volume.
DOLT_PASSWORD=e2e-dolt-vs-password
DOLT_ROOT_PASSWORD=e2e-dolt-root-password
BEADS_DOLT_PASSWORD=e2e-dolt-vs-password

# f57.14: primus (compose-simulated coordinator self-bootstrap). Deterministic
# simulation values — the hermes image is the REAL official image; the
# registrant-own pair runs the REAL vendored registrant. The AC12 assertions
# ride the ready marker + bundle files, NOT a live model call (the gateway
# key in the seeded bundle is a simulation value; no upstream traffic).
PRIMUS_DEVICE_UUID=11111111-2222-3333-4444-777777777777
PRIMUS_REGISTRAR_KEY=bk_e2e-00000000-0000-0000-0000-000000000003

# Slot auto-rearm window (seconds) for the E2E: sized so the volume-wipe +
# device restart in e2e.sh ALWAYS lands INSIDE the window — AC3 requires the
# 425→Retry-After retry loop to fire, and fails loudly if it didn't. 180s
# absorbs slow runners (GitHub-hosted: cold compose up, image pulls) with
# the redelivery still observable inside the 10-minute CI job budget.
# Production default is 1 hour.
SEED_REARM_SECONDS=180